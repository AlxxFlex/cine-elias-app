{
  "expo": {
    "name": "Cine Elías",
    "slug": "cine-elias-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cinema/icon.png",
    "scheme": "cineeliasapp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080808",
    "ios": {
      "icon": "./assets/cinema/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080808",
        "foregroundImage": "./assets/cinema/monochrome.png",
        "monochromeImage": "./assets/cinema/monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/cinema/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080808",
          "image": "./assets/cinema/mark.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
