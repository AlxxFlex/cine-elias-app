# Docker must expose port 8000 on the host. Include no /api suffix.
# Physical device: use your computer's LAN IP, on the same Wi-Fi network.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
# Android emulator: http://10.0.2.2:8000
# Browser / iOS simulator: http://localhost:8000
# Restart Metro after editing .env.local.
# If unset, the app detects the Metro LAN host where possible.
